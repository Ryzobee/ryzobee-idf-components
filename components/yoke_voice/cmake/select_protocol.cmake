# Select the protocol archive by ESP-IDF major version, never by a fallback.
function(gmf_ci1302_select_protocol component_dir out_archive out_build_version)
    if(NOT IDF_TARGET STREQUAL "esp32s3")
        message(FATAL_ERROR "yoke_voice supports ESP32-S3 only")
    endif()
    if(IDF_VERSION_MAJOR EQUAL 5)
        set(series idf5)
        set(build_version "5.5.1")
    elseif(IDF_VERSION_MAJOR EQUAL 6)
        set(series idf6)
        set(build_version "6.2.0")
    else()
        message(FATAL_ERROR "yoke_voice requires ESP-IDF major version 5 or 6")
    endif()
    set(archive "${component_dir}/ci1302_protocol/lib/esp32s3/${series}/libci1302_protocol.a")
    if(NOT EXISTS "${archive}")
        message(FATAL_ERROR "CI1302 ${series} archive is missing: ${archive}")
    endif()
    set(${out_archive} "${archive}" PARENT_SCOPE)
    set(${out_build_version} "${build_version}" PARENT_SCOPE)
endfunction()
